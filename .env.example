# Supabase Configuration
# Copia este archivo a .env y reemplaza con tus valores de Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (solo para seed/scripts)

# Web Push (VAPID) — https://web-push-codelab.glitch.me/
# Generá un par de llaves en https://vapidkeys.com/ o con:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
